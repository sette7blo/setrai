# ==================================================
# Setrai
# ==================================================

# Address the Setrai server listens on.
SETRAI_HOST=0.0.0.0

# Internal HTTP port used by Setrai.
SETRAI_PORT=3000

# Persistent application data directory.
# SQLite, media, and other Setrai-owned persistent files live here.
SETRAI_DATA_DIR=/data

# Optional explicit SQLite database path.
# Leave empty to use:
# <SETRAI_DATA_DIR>/setrai.db
SETRAI_DB_PATH=


# ==================================================
# Authentication (not implemented yet)
# ==================================================

# Not implemented yet: these two settings have no effect. Setrai has no login,
# so keep it on a trusted LAN or VPN, or put an authenticating proxy in front.
# API keys from Settings identify other apps but do not lock the web app or API.
SETRAI_AUTH_ENABLED=false
SETRAI_AUTH_PASSWORD=

# ==================================================
# AI (not implemented yet)
# ==================================================

# Setrai has no AI features yet, so these settings have no effect and
# /api/capabilities reports "ai": false. Core workout tracking never needs AI.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_MODEL=
OLLAMA_URL=http://ollama:11434

# SECRET: never commit a real value.
AI_API_KEY=
