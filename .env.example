# ==================================================
# Setrai
# ==================================================

# Address the Setrai server listens on.
SETRAI_HOST=0.0.0.0

# Internal HTTP port used by Setrai.
SETRAI_PORT=3000

# Persistent application data directory.
# SQLite, media, and other Setrai-owned persistent files live here.
SETRAI_DATA_DIR=/data

# Optional explicit SQLite database path.
# Leave empty to use:
# <SETRAI_DATA_DIR>/setrai.db
SETRAI_DB_PATH=


# ==================================================
# Authentication
# ==================================================

# Enable Setrai application authentication.
#
# Recommended when Setrai is exposed beyond a trusted LAN or VPN.
SETRAI_AUTH_ENABLED=false

# Application password.
#
# SECRET — never commit a real value.
#
# Required when password authentication is enabled.
SETRAI_AUTH_PASSWORD=


# ==================================================
# AI
# ==================================================

# Enable AI functionality.
#
# Core workout tracking continues to work when disabled.
AI_ENABLED=true

# AI backend.
#
# Initial supported provider:
# ollama
AI_PROVIDER=ollama

# Model requested from the configured provider.
#
# Example:
# AI_MODEL=qwen3
AI_MODEL=

# Ollama API endpoint.
#
# Docker example:
# http://ollama:11434
#
# Host example:
# http://127.0.0.1:11434
OLLAMA_URL=http://ollama:11434

# Optional API key for providers that require one.
#
# Ollama normally does not require this.
#
# SECRET — never commit a real value.
AI_API_KEY=


# ==================================================
# Nostr
# ==================================================

# Enable optional Nostr integration.
#
# When disabled:
# - no Nostr key is required
# - no relay connections are opened
# - no Nostr profile is loaded
# - Discover and Publish features are unavailable
NOSTR_ENABLED=false

# Nostr private key used by Setrai for server-side signing.
#
# Expected format:
# nsec1...
#
# SECRET — highly sensitive.
# Never expose this value to the browser or commit it to Git.
NOSTR_NSEC=

# Comma-separated secure Nostr relay URLs.
# Empty uses the Workstr catalog defaults documented in docs/configuration.md.
# Public Discover/import needs NOSTR_ENABLED=true but no private key.
#
# Example:
# NOSTR_RELAYS=wss://relay.example,wss://relay2.example
NOSTR_RELAYS=


# ==================================================
# Monero
# ==================================================

# Enable the optional Setrai Monero hot wallet.
#
# When disabled:
# - no wallet is initialized
# - no seed is required
# - no Monero node connection is required
# - wallet functionality is unavailable
MONERO_WALLET_ENABLED=false

# Seed for the dedicated Setrai Monero hot wallet.
#
# SECRET — extremely sensitive.
#
# Anyone with this seed can control the wallet.
# Use a dedicated wallet with limited operational funds.
#
# Never commit this value to Git.
MONERO_SEED=

# Monero node used by the wallet.
#
# May point to:
# - a public node
# - a self-hosted node
# - a node elsewhere on the local network
#
# Example:
# MONERO_NODE=https://node.example
MONERO_NODE=
