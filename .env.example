# ==================================================
# Setrai
# ==================================================

# Address the Setrai server listens on.
SETRAI_HOST=0.0.0.0

# Internal HTTP port used by Setrai.
SETRAI_PORT=3000

# Persistent application data directory.
# SQLite, media, and other Setrai-owned persistent files live here.
SETRAI_DATA_DIR=/data

# Optional explicit SQLite database path.
# Leave empty to use:
# <SETRAI_DATA_DIR>/setrai.db
SETRAI_DB_PATH=


# ==================================================
# Authentication
# ==================================================

# Enable Setrai application authentication.
#
# Recommended when Setrai is exposed beyond a trusted LAN or VPN.
SETRAI_AUTH_ENABLED=false

# Application password.
#
# SECRET — never commit a real value.
#
# Required when password authentication is enabled.
SETRAI_AUTH_PASSWORD=


# ==================================================
# Omarchy snapshot
# ==================================================

# Write a JSON snapshot of glanceable training state for the Omarchy bar plugin.
#
# Core workout tracking is unaffected when disabled.
SETRAI_OMARCHY_SNAPSHOT_ENABLED=false

# Snapshot file path.
# Leave empty to use:
# $XDG_DATA_HOME/setrai/snapshot.json
#
# Docker example (bind-mount the host directory to /snapshot):
# SETRAI_OMARCHY_SNAPSHOT_PATH=/snapshot/snapshot.json
SETRAI_OMARCHY_SNAPSHOT_PATH=

# Fallback refresh interval in milliseconds.
SETRAI_OMARCHY_SNAPSHOT_INTERVAL_MS=300000


# ==================================================
# AI
# ==================================================

# Enable AI functionality.
#
# Core workout tracking continues to work when disabled.
AI_ENABLED=true

# AI backend.
#
# Initial supported provider:
# ollama
AI_PROVIDER=ollama

# Model requested from the configured provider.
#
# Example:
# AI_MODEL=qwen3
AI_MODEL=

# Ollama API endpoint.
#
# Docker example:
# http://ollama:11434
#
# Host example:
# http://127.0.0.1:11434
OLLAMA_URL=http://ollama:11434

# Optional API key for providers that require one.
#
# Ollama normally does not require this.
#
# SECRET — never commit a real value.
AI_API_KEY=
