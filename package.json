{
  "name": "setrai",
  "version": "0.2.0",
  "private": true,
  "description": "Self-hosted AI-native fitness and training application.",
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server/index.js",
    "dev": "vite --host 0.0.0.0",
    "arch": "node scripts/check-architecture.mjs",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test tests/*.test.js",
    "test:client": "tsc -p tsconfig.client.test.json && node --test dist/client-tests/tests/client/*.test.js",
    "build": "tsc -p tsconfig.client.json && vite build",
    "check": "npm run arch && npm test && npm run build",
    "test:docker": "node scripts/test-docker.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sette7blo/setrai.git"
  },
  "bugs": {
    "url": "https://github.com/sette7blo/setrai/issues"
  },
  "homepage": "https://github.com/sette7blo/setrai#readme",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "dependencies": {
    "lucide": "^1.52.0",
    "nosleep.js": "^0.12.0"
  }
}
