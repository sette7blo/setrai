# Docker Compose installation. Keep your real .env private.
# Pin a published version instead of latest for controlled upgrades.
SETRAI_IMAGE=dockersette/setrai:latest
SETRAI_BIND_ADDRESS=127.0.0.1
SETRAI_HTTP_PORT=3000

# Optional integrations are off for a minimal installation.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_MODEL=
OLLAMA_URL=http://ollama:11434
AI_API_KEY=
# Built-in authentication is not implemented yet. Use an authenticated proxy/VPN.
SETRAI_AUTH_ENABLED=false
SETRAI_AUTH_PASSWORD=
