{
  "extends": "./tsconfig.client.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist/client-tests",
    "noEmit": false,
    "isolatedModules": false
  },
  "include": [
    "src/client/**/*.ts",
    "tests/client/**/*.ts"
  ]
}
